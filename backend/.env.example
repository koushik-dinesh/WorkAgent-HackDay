# Copy to backend/.env. Never commit the real file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MySQL from the root docker-compose.yml (host port 3307). Must match the root .env.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=meeting_action
DB_PASSWORD=change-me-app
DB_NAME=meeting_action
DB_TEST_NAME=meeting_action_test

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRES_IN=8h
# Optional override. Default: secure cookies only when NODE_ENV=production.
# COOKIE_SECURE=false
# Employee invitation links expire after this many hours (1-720). Invitations are emailed using
# the EMAIL_* settings below and link to APP_PUBLIC_URL, so both must be set to invite people.
INVITATION_TTL_HOURS=72

# Development seed (npm run seed). Choose your own values; min 12-char passwords.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Dev Admin
# Optional manager account (creates projects/teams it then manages)
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_MANAGER_NAME=Dev Manager
# Optional employee account for testing the employee view
SEED_EMPLOYEE_EMAIL=
SEED_EMPLOYEE_PASSWORD=
SEED_EMPLOYEE_NAME=Dev Employee
# Development dataset (npm run db:seed; docs/SEED_DATA_ARCHITECTURE.md). Password of every seeded
# account (min 12 chars; unset = accounts cannot sign in). Optional: anchor day, domain, Kavya's address.
SEED_USER_PASSWORD=
# SEED_ANCHOR_DATE=2026-11-15
# SEED_COMPANY_DOMAIN=arclight.example.com
# SEED_KAVYA_EMAIL=kavya.n@example.com

# --- WorkAPI: provider-independent AI (action-item extraction) --- see docs/WORKAPI.md
# One provider at a time. To switch, change these three lines only; no code changes.
#   gemini     Google Gemini API (key from Google AI Studio), e.g. a current Gemini model id
#   anthropic  Anthropic Claude API (key from the Claude Console), e.g. claude-opus-5-5
# WORKAPI_API_KEY is the key of the selected provider. It stays in the backend, is never logged
# and never reaches the browser. Without it, AI extraction is disabled (everything else works).
WORKAPI_PROVIDER=gemini
WORKAPI_API_KEY=your_gcp_api_key_here

WORKAPI_MODEL=gemini-2.5-flash
# Optional: another endpoint for the selected provider (proxy, regional or compatible gateway).
WORKAPI_BASE_URL=
# Per request, in milliseconds. Raise for long meetings on slow models (e.g. 300000).
WORKAPI_TIMEOUT=60000
# Retries of rate limits, timeouts and outages inside one job attempt (0-5).
WORKAPI_MAX_RETRIES=2
WORKAPI_MAX_OUTPUT_TOKENS=32000
# Optional provider-specific settings, JSON, validated by the selected adapter at startup:
#   gemini:    {"temperature":0.2,"thinkingLevel":"LOW"}   (thinkingBudget also accepted)
#   anthropic: {"effort":"high","refusalFallback":true,"cacheSystemPrompt":true}
WORKAPI_PROVIDER_OPTIONS=
# Optional: your contract prices for the configured model (USD per million tokens). Unset = token
# counts only; WorkAgent never guesses prices. Update them when you switch provider or model.
WORKAPI_PRICE_INPUT_USD_PER_MTOK=
WORKAPI_PRICE_OUTPUT_USD_PER_MTOK=

# IANA timezone used to resolve relative deadlines ("tomorrow", "Friday")
MEETING_TIMEZONE=UTC
EXTRACTION_MAX_TRANSCRIPT_CHARS=600000
EXTRACTION_OUTPUT_LANGUAGE=English

# --- Background worker (npm run worker) ---
WORKER_POLL_INTERVAL_MS=2000
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=30000
JOB_STALE_AFTER_MS=300000
# Optional: run only these job types in this worker (comma list). Recommended in production: one
# worker for "ai.extract,email.send,vexa.poll" and one for "integration.sync,integration.webhook".
WORKER_JOB_TYPES=

# --- Email notifications (Phase 5) ---
# smtp | resend. Leave empty to disable sending.
# Local development: Mailpit from docker-compose (web UI http://localhost:8025) catches everything.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Meeting to Action <no-reply@example.test>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Only for EMAIL_PROVIDER=resend. Needs a verified sending domain to reach arbitrary recipients.
RESEND_API_KEY=
EMAIL_MAX_ATTEMPTS=5
# Public URL of the web app, linked from emails. Leave empty to omit the link.
APP_PUBLIC_URL=http://localhost:5173

# --- Vexa meeting bot (Phase 7) ---
# Vexa runs as its own Docker Compose project (see README). Gateway default: http://localhost:18056
VEXA_BASE_URL=
# API key printed by Vexa's `make all` (needs the bot and tx scopes). Never sent to the browser.
VEXA_API_KEY=
VEXA_BOT_NAME=Meeting to Action
VEXA_REQUEST_TIMEOUT_MS=15000
VEXA_POLL_INTERVAL_MS=15000
VEXA_POLL_TIMEOUT_MS=14400000
VEXA_TRANSCRIPT_WAIT_MS=300000
# Queue AI extraction automatically after a Vexa transcript is saved (never approves or emails).
VEXA_AUTO_EXTRACT=true
# Automatic transcription (docs/integrations/VEXA_SETUP.md). Connect once on Integrations; then
# Google Meet meetings found in connected calendars get a bot. Webhooks are optional (polling is the
# source of truth): set both to have Vexa push status changes, signed with the secret.
VEXA_WEBHOOK_SECRET=
VEXA_WEBHOOK_PUBLIC_URL=
VEXA_AUTO_LOOKAHEAD_HOURS=24
VEXA_AUTO_MAX_DISPATCH_ATTEMPTS=5

# --- Meeting transcripts from connected tools (Teams, Google Meet connector) ---
# Queue AI extraction after a transcript is imported (never approves or emails).
TRANSCRIPT_AUTO_EXTRACT=true
# Only look for transcripts of meetings that ended within this many days (1-90).
TRANSCRIPT_IMPORT_LOOKBACK_DAYS=7

# --- Integrations (Phase 3A) ---
# Encrypts stored integration credentials. One key per deployment; store it separately from
# database backups. Generate with: openssl rand -base64 32
# Losing it only means connections must be reconnected (synced data is not encrypted).
CREDENTIALS_ENCRYPTION_KEY=
# Rotation: move the old key here, put a new one above, restart, re-encrypt, then clear this.
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
# Adds a built-in fake provider (no network) for trying the Integrations screens locally.
# Ignored when NODE_ENV=production.
INTEGRATIONS_FAKE_PROVIDER=false
# Re-sync every enabled resource this often (minutes); webhooks bring changes in between.
INTEGRATION_SYNC_INTERVAL_MIN=15
# First sync covers this many days of history (plus items still open).
INTEGRATION_BACKFILL_DAYS=90
# Each sync job stops after this long / this many provider requests and lets other jobs run.
INTEGRATION_SYNC_CHUNK_MS=20000
INTEGRATION_SYNC_CHUNK_REQUESTS=10
# Pause a connection when fewer provider requests than this remain in its rate-limit window.
INTEGRATION_RATE_LIMIT_RESERVE=200
# Webhooks arrive at POST /api/v1/webhooks/<provider>. In development expose ONLY that path
# through the tunnel (see docs). Largest accepted body, and how long payloads are kept.
WEBHOOK_MAX_BYTES=10485760
WEBHOOK_PAYLOAD_RETENTION_DAYS=14
# Public base URL providers send webhooks to (shown on the Integrations page), e.g. your
# Cloudflare Tunnel hostname: https://workagent-dev.example.com
PUBLIC_WEBHOOK_BASE_URL=

# --- GitHub App (Phase 3B) --- see docs/runbooks/integrations.md §8 to create the App.
# Leave GITHUB_APP_ID empty to keep GitHub unavailable. Never commit real values.
GITHUB_APP_ID=
# The App's URL name: https://github.com/apps/<slug>
GITHUB_APP_SLUG=
# The App's private key: either a path to the downloaded .pem file (recommended, chmod 600)...
GITHUB_APP_PRIVATE_KEY_PATH=
# ...or the PEM text with newlines written as \n. Set only one of the two.
GITHUB_APP_PRIVATE_KEY=
# The App's webhook secret (generate: openssl rand -hex 32). PREVIOUS is accepted during rotation.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET_PREVIOUS=
# Only for GitHub Enterprise Server (must be https in production).
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# --- Jira Cloud (OAuth 2.0 3LO) --- see docs/runbooks/integrations.md §11.
# The Atlassian app needs read:jira-work and read:jira-user.
# Creating issues from approved action items (§11.6) is opt-in: add write:jira-work to the app first,
# set this to true, restart, then Connect Jira again.
JIRA_ISSUE_CREATION=false
# Leave JIRA_CLIENT_ID empty to keep Jira unavailable. Never commit real values.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# The one Jira site this deployment syncs.
JIRA_SITE_URL=https://your-company.atlassian.net
# Secret of the webhook registered in Jira (System > WebHooks). Empty = Jira is polled only.
JIRA_WEBHOOK_SECRET=
JIRA_AUTH_URL=https://auth.atlassian.com
JIRA_API_URL=https://api.atlassian.com

# --- Microsoft 365: Teams and Outlook (one single-tenant Entra app) --- see runbook §12.
# Delegated Graph permissions with admin consent. Teams meeting transcripts additionally need
# Calendars.Read, OnlineMeetings.Read and OnlineMeetingTranscript.Read.All (runbook §12.1, §12.5).
# Leave MS_CLIENT_ID empty to keep both unavailable. Never commit real values.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_LOGIN_URL=https://login.microsoftonline.com
MS_GRAPH_URL=https://graph.microsoft.com

# --- Google Calendar (Google Workspace OAuth client) --- see runbook §13.
# Calendar only: meeting discovery for Vexa, free/busy, event creation. Google Meet transcripts come
# from Vexa, so there is no Google Meet integration any more. Leave GOOGLE_CLIENT_ID empty to keep
# Google Calendar unavailable. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only accounts of this Workspace domain can connect.
GOOGLE_WORKSPACE_DOMAIN=
# With no domain set: true lets any Google account connect (personal Gmail included). Default false.
GOOGLE_ALLOW_PERSONAL_ACCOUNTS=false
GOOGLE_AUTH_URL=https://accounts.google.com
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_CALENDAR_API_URL=https://www.googleapis.com

# --- Figma (OAuth app) --- see runbook §14 and docs/integrations/FIGMA_SETUP.md.
# Leave FIGMA_CLIENT_ID empty to keep Figma unavailable. Never commit real values.
# Mandatory to connect: FIGMA_CLIENT_ID, FIGMA_CLIENT_SECRET, FIGMA_TEAM_ID, and FIGMA_REDIRECT_URI
# (or APP_PUBLIC_URL), plus CREDENTIALS_ENCRYPTION_KEY. Use a PRIVATE Figma OAuth app.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
# Must equal the redirect URL registered on the Figma app. Default: <APP_PUBLIC_URL>/integrations/figma/setup
FIGMA_REDIRECT_URI=
# Preferred name for the API base URL (FIGMA_API_URL below still works; this one wins).
FIGMA_API_BASE_URL=https://api.figma.com
# The team whose projects are synced (figma.com/files/team/<id>/...).
FIGMA_TEAM_ID=
# Passcode used when registering Figma webhooks (openssl rand -hex 32). Empty = polling only.
FIGMA_WEBHOOK_PASSCODE=
FIGMA_AUTH_URL=https://www.figma.com
FIGMA_API_URL=https://api.figma.com


# --- Microsoft Teams mode --- docs/integrations/MICROSOFT_TEAMS_MOCK_SETUP.md
# real (Microsoft Graph OAuth, default), mock (DEVELOPMENT MOCK: fictional Violin Technologies data,
# refused in production), or disabled.
TEAMS_INTEGRATION_MODE=mock

# --- Features 2-6 (docs/FEATURES.md) ---
# Embeddings for duplicate work detection (optional). Unset model = text similarity is used instead.
# Provider and key default to WORKAPI_PROVIDER / WORKAPI_API_KEY when the provider has embeddings
# (Gemini does; Anthropic does not — with WORKAPI_PROVIDER=anthropic set WORKAPI_EMBEDDING_PROVIDER=gemini
# and WORKAPI_EMBEDDING_API_KEY). Changing the model starts a controlled re-index.
WORKAPI_EMBEDDING_PROVIDER=
WORKAPI_EMBEDDING_API_KEY=
WORKAPI_EMBEDDING_MODEL=
WORKAPI_EMBEDDING_DIMENSIONS=768
# Group invitations / assistant meetings: opt-in calendar write scopes (reconnect after turning on).
OUTLOOK_CALENDAR_WRITE=false
GOOGLE_CALENDAR_WRITE=false
# Directory sync (departments, job titles, groups): opt-in; needs admin consent / a Workspace admin.
MS_DIRECTORY_SYNC=false
GOOGLE_DIRECTORY_SYNC=false
# A group or attendee list above this size needs a second confirmation.
GROUP_LARGE_THRESHOLD=50
# Organisation time zone (weekly digest cut-off, KPI periods). Default: MEETING_TIMEZONE.
ORG_TIMEZONE=
# Assistant: seconds an executed command can be undone (0 = no undo).
ASSISTANT_UNDO_SECONDS=60
# Execution engine (docs/ACTION_INTELLIGENCE.md): approved writes wait this many seconds (cancel
# window) before running; plans touching more records/people than the threshold need a second
# confirmation. TEAMS_MESSAGE_SEND=true asks Teams for ChannelMessage.Send (reconnect Teams).
ACTION_CANCEL_SECONDS=60
ACTION_LARGE_THRESHOLD=10
TEAMS_MESSAGE_SEND=false
# Voice: server-side speech-to-text (Google Cloud Speech-to-Text, API key). Empty = the browser's
# own speech recognition is used where available. The key stays in the backend.
SPEECH_PROVIDER=
SPEECH_API_KEY=
SPEECH_LANGUAGE=en-US
SPEECH_API_URL=https://speech.googleapis.com
# Weekly digest to a Microsoft Teams channel (incoming webhook / Workflows URL). Team counts only.
DIGEST_TEAMS_WEBHOOK_URL=
